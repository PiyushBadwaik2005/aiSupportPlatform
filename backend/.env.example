# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=https://aisupportplatform-2.onrender.com

# Database (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/ai_support_platform

# Security & Authentication
JWT_SECRET=replace-with-a-secure-random-32-char-string-in-production
JWT_EXPIRES_IN=7d
AUTH_SESSION_SECRET=replace-with-a-secure-session-secret-key
API_KEY_PEPPER=replace-with-a-secure-api-key-pepper-string

# AI & Gemini Configuration
# Provide your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Document Upload Limits
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_STORAGE_PATH=./uploads

# RAG & Retrieval Tuning
# Options: 'keyword' (default, zero-setup), 'vector' (Atlas Vector Search), 'hybrid'
RAG_RETRIEVAL_MODE=keyword
RAG_MIN_RELEVANCE_SCORE=0.35
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MAX_RETRIEVED_CHUNKS=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

